# Copy to .env (which is git-ignored) for local exploration scripts.
# Databricks never reads this file: it reads the same values from the `aq` secret scope (see README).

# explore.openaq.org → sign in → Account → API key
OPENAQ_API_KEY=

# huggingface.co → Settings → Access Tokens → fine-grained, write access to your model + dataset repos
HF_TOKEN=
